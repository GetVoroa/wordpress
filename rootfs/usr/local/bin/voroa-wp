#!/usr/local/bin/php
<?php
// voroa-wp - the Managed WordPress panel's ONE WordPress program (Voroa plan 2026-11-13 PR C, CTO r1 D6/H2).
// Runs as www-data via `docker exec -i -u www-data`. The request is base64(JSON) on STDIN. Each action maps to a
// FIXED wp-cli argv built here - never a free-form command, never a shell (proc_open with an argv array).
// Output: one JSON object on stdout.
declare(strict_types=1);

const WP = '/var/www/html';

function out(array $o): void { echo json_encode($o, JSON_UNESCAPED_SLASHES), "\n"; exit(0); }
function fail(string $code, string $msg): void { out(['ok' => false, 'code' => $code, 'error' => $msg]); }

$req = json_decode((string) base64_decode((string) stream_get_contents(STDIN, 1048576), true), true);
if (!is_array($req) || !isset($req['op']) || !is_string($req['op'])) fail('bad_request', 'The request could not be read.');

// A plugin/theme slug or a user login: a closed shape, so it can never become a flag or a path.
function slug($v): string {
	if (!is_string($v) || !preg_match('/^[a-z0-9][a-z0-9._-]{0,99}$/i', $v)) fail('bad_name', 'That name is not valid.');
	return $v;
}
function url($v): string {
	if (!is_string($v) || strlen($v) > 300 || !preg_match('#^https?://[a-z0-9.-]+(:[0-9]{1,5})?(/[^\s]*)?$#i', $v)) fail('bad_url', 'That address is not valid.');
	return rtrim($v, '/');
}

// run wp-cli with a fixed argv; stdin optional (a password goes there, never on argv).
function wp(array $args, ?string $stdin = null): array {
	$argv = array_merge(['/usr/local/bin/wp', '--path=' . WP, '--no-color'], $args);
	$p = proc_open($argv, [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);
	if (!is_resource($p)) fail('run_failed', 'The action could not start.');
	if ($stdin !== null) fwrite($pipes[0], $stdin);
	fclose($pipes[0]);
	$o = stream_get_contents($pipes[1]); $e = stream_get_contents($pipes[2]);
	fclose($pipes[1]); fclose($pipes[2]);
	return ['code' => proc_close($p), 'out' => (string) $o, 'err' => (string) $e];
}
function must(array $r, string $msg): string {
	if ($r['code'] !== 0) fail('wp_failed', $msg);
	return $r['out'];
}
function jsonList(string $s): array { $v = json_decode($s, true); return is_array($v) ? $v : []; }

// content_file(rel, ext) -> the real path of an existing .<ext> file inside wp-content (never a link, never outside).
function content_file($rel, string $ext): string {
	if (!is_string($rel) || !preg_match('#^[A-Za-z0-9._/-]{1,300}\.' . $ext . '$#', $rel) || strpos($rel, '..') !== false) fail('bad_path', "Choose a .{$ext} file inside wp-content.");
	$root = realpath(WP . '/wp-content');
	$abs = WP . '/wp-content/' . ltrim($rel, '/');
	$src = realpath($abs);
	if ($src === false || strpos($src, $root . '/') !== 0 || is_link($abs) || !is_file($src)) fail('not_found', "That .{$ext} file was not found in wp-content.");
	return $src;
}
// The dump's table prefix, read from its first `...options` table (null when the dump names none).
function sql_prefix(string $src): ?string {
	$in = fopen($src, 'rb');
	$n = 0;
	while ($in && ($line = fgets($in)) !== false && $n++ < 200000) {
		if (preg_match('/CREATE TABLE `([A-Za-z0-9_]*?)options`/', $line, $m)) { fclose($in); return $m[1]; }
	}
	if ($in) fclose($in);
	return null;
}
// Import with MySQL 8's utf8mb4_0900_* collations rewritten to utf8mb4_unicode_520_ci (MariaDB has no 0900 set).
function import_sql(string $src): void {
	$tmp = tempnam(sys_get_temp_dir(), 'voroa-import');
	$in = fopen($src, 'rb'); $outF = fopen($tmp, 'wb');
	if (!$in || !$outF) fail('read_failed', 'The file could not be read.');
	while (($line = fgets($in)) !== false) { fwrite($outF, preg_replace('/utf8mb4_0900_[a-z_]+/', 'utf8mb4_unicode_520_ci', $line)); }
	fclose($in); fclose($outF);
	$r = wp(['db', 'import', $tmp, '--skip-plugins', '--skip-themes']);
	@unlink($tmp);
	if ($r['code'] !== 0) fail('wp_failed', 'The import failed: ' . substr(trim($r['err']), 0, 300));
}
// Unzip into wp-content. Entry names are checked one by one: no absolute path, no "..", nothing into voroa/ (salts);
// a leading "wp-content/" folder is dropped so both zip shapes work. Returns the number of files written.
function unzip_content(string $zipFile): int {
	$z = new ZipArchive();
	if ($z->open($zipFile) !== true) fail('bad_zip', 'That zip file could not be opened.');
	$root = realpath(WP . '/wp-content');
	$files = 0;
	for ($i = 0; $i < $z->numFiles; $i++) {
		$name = str_replace('\\', '/', (string) $z->getNameIndex($i));
		$rel = preg_replace('#^wp-content/#', '', ltrim($name, '/'));
		if ($rel === '' || substr($rel, -1) === '/') continue;
		$segs = explode('/', $rel);
		if (in_array('..', $segs, true) || in_array('.', $segs, true) || $segs[0] === 'voroa' || strpos($name, "\0") !== false || preg_match('#^[A-Za-z]:#', $name)) {
			$z->close();
			fail('bad_zip', 'The zip has a file outside wp-content (' . substr($name, 0, 120) . ').');
		}
		$dest = $root . '/' . $rel;
		if (!is_dir(dirname($dest)) && !mkdir(dirname($dest), 0755, true)) { $z->close(); fail('write_failed', 'A folder could not be created.'); }
		if (is_link($dest)) { $z->close(); fail('bad_zip', 'The zip would write through a link.'); }
		$inS = $z->getStream($z->getNameIndex($i));
		$outS = $inS ? fopen($dest, 'wb') : false;
		if (!$inS || !$outS) { $z->close(); fail('write_failed', 'A file could not be written.'); }
		stream_copy_to_stream($inS, $outS);
		fclose($inS); fclose($outS);
		$files++;
	}
	$z->close();
	return $files;
}

$op = $req['op'];
switch ($op) {
	case 'plugins':
		out(['ok' => true, 'items' => jsonList(must(wp(['plugin', 'list', '--fields=name,title,status,version,update,update_version', '--format=json']), 'Plugins could not be listed.'))]);
	case 'themes':
		out(['ok' => true, 'items' => jsonList(must(wp(['theme', 'list', '--fields=name,title,status,version,update,update_version', '--format=json']), 'Themes could not be listed.'))]);
	case 'plugin':
	case 'theme': {
		$allowed = $op === 'plugin' ? ['activate', 'deactivate', 'update', 'delete'] : ['activate', 'update', 'delete'];
		$action = $req['action'] ?? '';
		if (!in_array($action, $allowed, true)) fail('bad_action', 'That action is not available.');
		must(wp([$op, $action, slug($req['name'] ?? null)]), "The {$op} could not be changed.");
		out(['ok' => true]);
	}
	// Emergency (works with wp-admin down): every plugin off, or the default theme on - plugins/themes skipped so a
	// broken one cannot stop the fix.
	case 'emergency_plugins_off':
		must(wp(['plugin', 'deactivate', '--all', '--skip-plugins', '--skip-themes']), 'Plugins could not be turned off.');
		out(['ok' => true]);
	case 'emergency_default_theme': {
		$list = jsonList(must(wp(['theme', 'list', '--field=name', '--format=json', '--skip-plugins', '--skip-themes']), 'Themes could not be listed.'));
		$pick = null;
		foreach ($list as $n) { if (is_string($n) && preg_match('/^twenty/', $n)) { $pick = $n; } }
		if ($pick === null) fail('no_default_theme', 'No default WordPress theme is installed.');
		must(wp(['theme', 'activate', $pick, '--skip-plugins', '--skip-themes']), 'The default theme could not be turned on.');
		out(['ok' => true, 'theme' => $pick]);
	}
	case 'admins':
		out(['ok' => true, 'items' => jsonList(must(wp(['user', 'list', '--role=administrator', '--fields=user_login,user_email', '--format=json', '--skip-plugins', '--skip-themes']), 'Admins could not be listed.'))]);
	case 'admin_password': {
		// the new password arrives in the request and goes to wp-cli on stdin - never echoed back, never logged
		$pw = $req['password'] ?? '';
		if (!is_string($pw) || strlen($pw) < 12 || strlen($pw) > 200) fail('bad_password', 'Use a password of 12 to 200 characters.');
		must(wp(['user', 'update', slug($req['user'] ?? null), '--prompt=user_pass', '--skip-plugins', '--skip-themes', '--skip-email'], $pw . "\n"), 'The password could not be changed.');
		out(['ok' => true]);
	}
	case 'search_replace': {
		$from = url($req['from'] ?? null); $to = url($req['to'] ?? null);
		if ($from === $to) fail('same', 'The two addresses are the same.');
		$args = ['search-replace', $from, $to, '--all-tables-with-prefix', '--precise', '--skip-columns=guid', '--format=count', '--skip-plugins', '--skip-themes'];
		if (empty($req['apply'])) $args[] = '--dry-run';
		$n = trim(must(wp($args), 'The addresses could not be replaced.'));
		if (!empty($req['apply'])) {
			must(wp(['option', 'update', 'home', $to, '--skip-plugins', '--skip-themes']), 'The site address could not be saved.');
			must(wp(['option', 'update', 'siteurl', $to, '--skip-plugins', '--skip-themes']), 'The site address could not be saved.');
			wp(['cache', 'flush', '--skip-plugins', '--skip-themes']);
		}
		out(['ok' => true, 'count' => (int) $n, 'applied' => !empty($req['apply'])]);
	}
	// Database browser: store only the SHA-256 of the one-time token the panel minted, with its expiry (gate.php).
	case 'adminer_grant': {
		$hash = $req['tokenHash'] ?? '';
		if (!is_string($hash) || !preg_match('/^[0-9a-f]{64}$/', $hash)) fail('bad_request', 'The link could not be prepared.');
		$dir = WP . '/wp-content/voroa/adminer/grants';
		if (!is_dir($dir) && !mkdir($dir, 0700, true)) fail('write_failed', 'The link could not be prepared.');
		foreach (glob($dir . '/*') ?: [] as $old) { if ((int) @file_get_contents($old) < time()) @unlink($old); }
		if (file_put_contents($dir . '/' . $hash, (string) (time() + 600)) === false) fail('write_failed', 'The link could not be prepared.');
		out(['ok' => true, 'expiresIn' => 600]);
	}
	// Export: the whole database to wp-content/voroa-export/database.sql (download it from the File Manager or SFTP).
	case 'db_export': {
		$dir = WP . '/wp-content/voroa-export';
		if (!is_dir($dir) && !mkdir($dir, 0750, true)) fail('write_failed', 'The export folder could not be created.');
		$file = $dir . '/database.sql';
		must(wp(['db', 'export', $file, '--add-drop-table', '--skip-plugins', '--skip-themes']), 'The database could not be exported.');
		out(['ok' => true, 'path' => 'voroa-export/database.sql', 'size' => filesize($file)]);
	}
	// Import a .sql file already on the site (uploaded with the File Manager or SFTP, inside wp-content). MySQL 8 dumps
	// name utf8mb4_0900_* collations MariaDB does not have: they are rewritten to utf8mb4_unicode_520_ci first.
	case 'db_import':
		import_sql(content_file($req['path'] ?? '', 'sql'));
		wp(['cache', 'flush', '--skip-plugins', '--skip-themes']);
		out(['ok' => true]);
	// Migrate in (PR F): a site from another host - its database dump and (optionally) a zip of its wp-content, both
	// already in wp-content (File Manager or SFTP). Unzip (zip-slip safe, never over wp-content/voroa), import, then
	// replace the old address with this site's. A dump with a table prefix other than wp_ is refused with the reason.
	case 'migrate': {
		$sql = content_file($req['sqlPath'] ?? '', 'sql');
		$prefix = sql_prefix($sql);
		if ($prefix !== null && $prefix !== 'wp_') fail('prefix', "That database uses the table prefix \"{$prefix}\". Ask us for migration help - we move sites like this for free.");
		$files = 0;
		if (!empty($req['zipPath'])) $files = unzip_content(content_file($req['zipPath'], 'zip'));
		import_sql($sql);
		$count = 0;
		if (!empty($req['from']) && !empty($req['to']) && $req['from'] !== $req['to']) {
			$from = url($req['from']); $to = url($req['to']);
			$count = (int) trim(must(wp(['search-replace', $from, $to, '--all-tables-with-prefix', '--precise', '--skip-columns=guid', '--format=count', '--skip-plugins', '--skip-themes']), 'The addresses could not be replaced.'));
			wp(['option', 'update', 'home', $to, '--skip-plugins', '--skip-themes']);
			wp(['option', 'update', 'siteurl', $to, '--skip-plugins', '--skip-themes']);
		}
		wp(['cache', 'flush', '--skip-plugins', '--skip-themes']);
		if (function_exists('opcache_reset')) opcache_reset();
		out(['ok' => true, 'files' => $files, 'replaced' => $count]);
	}
	// The PHP settings the site RUNS with (the panel shows these - read live, not from stored settings).
	case 'php':
		out(['ok' => true, 'memoryLimit' => ini_get('memory_limit'), 'uploadMax' => ini_get('upload_max_filesize'),
			'maxExecutionTime' => (int) ini_get('max_execution_time'), 'maxInputVars' => (int) ini_get('max_input_vars'), 'php' => PHP_VERSION]);
	case 'site_url':
		out(['ok' => true, 'home' => trim(must(wp(['option', 'get', 'home', '--skip-plugins', '--skip-themes']), 'The site address could not be read.'))]);
	default:
		fail('bad_op', 'That action is not available.');
}
