#!/bin/bash
# Managed WordPress PID 1 (ADR-0379): prepares /data, starts MariaDB (socket only), then the standard WordPress
# entrypoint as a child. If MariaDB OR the WordPress side stops, the container exits so the platform restarts it -
# a site never sits "running" while showing a database error.
set -euo pipefail
D=/data
mkdir -p "$D/wp-content" "$D/mysql" "$D/backup" "$D/voroa" /run/mysqld
chown mysql:mysql "$D/mysql" /run/mysqld
chmod 700 "$D/backup"
chown root:www-data "$D/voroa"; chmod 750 "$D/voroa"   # www-data must reach db.php, nobody else

# MariaDB memory: a quarter of the container for the buffer pool (measured: a 1 GB site peaked at 164 MB).
MEM_MAX=$(cat /sys/fs/cgroup/memory.max 2>/dev/null || echo max)
if [ "$MEM_MAX" = "max" ]; then MEM_MB=1024; else MEM_MB=$(( MEM_MAX / 1048576 )); fi
printf '[mysqld]\ninnodb_buffer_pool_size = %sM\n' "$(( MEM_MB / 4 ))" > /run/voroa-mariadb-size.cnf

if [ ! -d "$D/mysql/mysql" ]; then
  echo "[voroa-wp] creating the database"
  mariadb-install-db --user=mysql --datadir="$D/mysql" --skip-test-db >/dev/null
fi

mariadbd --user=mysql &
DB=$!
for _ in $(seq 1 60); do mariadb -uroot -e 'SELECT 1' >/dev/null 2>&1 && break; sleep 1; done
mariadb -uroot -e 'SELECT 1' >/dev/null 2>&1 || { echo "[voroa-wp] the database did not start" >&2; exit 1; }

# The site's database account: created once, password kept on the disk (0640 root:www-data), never in env.
CRED="$D/voroa/db.php"
if [ ! -s "$CRED" ]; then
  PW=$(php -r 'echo bin2hex(random_bytes(24));')
  mariadb -uroot -e "CREATE DATABASE IF NOT EXISTS wordpress CHARACTER SET utf8mb4; CREATE USER IF NOT EXISTS 'wordpress'@'localhost' IDENTIFIED BY '${PW}'; ALTER USER 'wordpress'@'localhost' IDENTIFIED BY '${PW}'; GRANT ALL ON wordpress.* TO 'wordpress'@'localhost'; FLUSH PRIVILEGES;"
  printf "<?php\ndefine('VOROA_DB_NAME', 'wordpress');\ndefine('VOROA_DB_USER', 'wordpress');\ndefine('VOROA_DB_PASSWORD', '%s');\ndefine('VOROA_DB_HOST', 'localhost:/run/mysqld/mysqld.sock');\n" "$PW" > "$CRED"
  unset PW
fi
chown root:www-data "$CRED"; chmod 640 "$CRED"
export DB_MAX_CONNECTIONS=40

/usr/local/bin/voroa-entrypoint &
WEB=$!

term() { kill -TERM "$WEB" 2>/dev/null || true; wait "$WEB" 2>/dev/null || true; mariadb-admin -uroot shutdown >/dev/null 2>&1 || kill -TERM "$DB" 2>/dev/null || true; wait "$DB" 2>/dev/null || true; exit 0; }
trap term TERM INT

wait -n "$DB" "$WEB" || true
echo "[voroa-wp] the database or the web server stopped - exiting so the platform restarts the site" >&2
kill -TERM "$WEB" "$DB" 2>/dev/null || true
exit 1
